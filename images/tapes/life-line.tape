# README image: the Life one-liner pretty-printed (just pp).
Output "target/screens/life-line.gif"
Set Shell bash
Set FontSize 18
Set Width 1080
Set Height 110
Set Padding 16
Hide
Type `clear; ./target/debug/xetal render --color -e "u:l_ife := { ('+ r_/_12 -1 0 1 o_-_12 _r) { (_l = 3) + _r * _l = 4 } _r }"`
Enter
Sleep 1s
Show
Sleep 1s
