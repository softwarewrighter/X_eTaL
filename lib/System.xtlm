# System.xtlm: the system macros (lang-choices MC18, MC19, MC24).
# Loaded before every file, with no import and no alias: each s:
# macro here is called unprefixed ("c" i_f< "a; b"). Like any macro, a
# system macro is a function of the source text on each side of its
# call that gives the text replacing the call. What only the compiler
# knows comes from hooks ([]R_EJECT, []S_TATEMENT; MC20), usable only
# in a macro body. Names without s: are private helpers.

# "c:" u_se< "Name" is a system macro too, but built into xetal, not
# defined here (MC21). Were it a macro of this file, it would read:
#
#   s:u_se< := { alias name -> ... }
#
# taking the two texts, the alias ("c:") on the left and the library's
# name or path ("Name") on the right, like any macro. But what u_se<
# does is not text: it finds Name.xtl and Name.xtlm, loads them, and
# makes their exported names exist in this file under c:. A macro
# cannot do that: a macro of yours gives source text, and that text can
# only use names that exist, never create bindings the way an import
# does. So the compiler does u_se< itself, and this comment stands in
# for its definition, as Rust's std declares include_str! with a body
# its compiler builds.

# "c" i_f< "a; b": the value of a when c holds, else of b, chosen when
# the program runs; only the one chosen is evaluated (MC14).
s:i_f< := { cond both ->
  p := w_here s_eps both
  1 != t_ally p ? "bad-macro-argument right" []R_EJECT ifArgs
  a := t_rim ((f_irst p) - 1) t_ake both
  b := t_rim (f_irst p) d_rop both
  (0 = t_ally a) | 0 = t_ally b ? "bad-macro-argument right" []R_EJECT ifArgs
  "{ @ -> (" c_at (t_rim cond) c_at ") ? " c_at a c_at "; " c_at b c_at " } @"
}

# "c" u_nless< "b": run the statements b unless c holds; the value is
# @ (MC15).
s:u_nless< := { cond body ->
  "{ @ -> (" c_at (t_rim cond) c_at ") ? @; " c_at (t_rim body) c_at "; @ } @"
}

# "w1 w2" e_ach< "template": one statement per word, $w in the template
# replaced by the word (MC16).
s:e_ach< := { words template ->
  n_ot []S_TATEMENT @ ? "misplaced-macro call" []R_EJECT eachAlone
  ws := w_ords words
  0 = t_ally ws ? "bad-macro-argument left" []R_EJECT "e_ach< needs words on its left"
  0 = '+ r_/ 0 + h_oles template ? "bad-macro-argument right" []R_EJECT eachHole
  d_isclose '{ a b -> e_nclose (d_isclose a) c_at "\n" c_at d_isclose b } r_/ '{ w -> template c_opy d_isclose w } m_ap ws
}

# @ l_ine< @: the line the call is written on, as a number (inside
# another macro's expansion, the line of that macro's call).
s:l_ine< := { u v -> u n_othing v n_othing f_ormat []L_INE @ }

# @ f_ile< @: the file the call is written in, as text (-e for text
# given on the command line).
s:f_ile< := { u v -> u n_othing v n_othing q_uote []F_ILE @ }

# @ i_nclude< "path": the text of the file at path, relative to the
# file the call is written in, as a string (Rust's include_str!).
s:i_nclude< := { u path -> u n_othing q_uote []I_NCLUDE t_rim path }

# @ c_fg< "name": 1 when the fact holds, else 0: the platform (cli, or
# web in the browser) or a flag set with xetal --cfg NAME.
s:c_fg< := { u name -> u n_othing f_ormat 0 + []C_FG t_rim name }

# "code" e_rror< "message": stop with a compile error at the call, with
# that code and message (Rust's compile_error!); a macro writes it into
# its text to refuse a call.
s:e_rror< := { code message -> ((t_rim code) c_at " call") []R_EJECT message }

ifArgs := "i_f< takes two expressions on its right, separated by ;: \"c\" i_f< \"a; b\""
eachAlone := "e_ach< writes statements: it stands as a statement of its own"
eachHole := "an e_ach< template names the word as $w: \"a b\" e_ach< \"u:$w := 1\""

# The text t without white space at its ends.
t_rim := { t ->
  m := n_ot t m_ember? " \n\t"
  0 = '+ r_/ 0 + m ? ""
  i := w_here m
  (1 + (f_irst r_ev i) - f_irst i) t_ake ((f_irst i) - 1) d_rop t
}

# The words of t: runs of characters other than white space, boxed.
w_ords := { t -> (n_ot t m_ember? " \n\t") p_artition t }

# Where t separates statements: a ; or a newline outside brackets and
# strings.
s_eps := { t ->
  q := ('+ s_\ 0 + t = f_irst "\"") m_od 2
  d := '+ s_\ (0 + t m_ember? "([{") - 0 + t m_ember? ")]}"
  (t m_ember? ";\n") & (0 = d) & 0 = q
}

# Where $w starts in t.
h_oles := { t -> (t = f_irst "$") & (1 d_rop t = f_irst "w") c_at 0 }

# x, once u (the side of a call that takes no argument, @) is Unit.
n_othing := { u x -> ({ @ -> x })_ u }

# The boxed texts b joined into one text.
j_oin := { b -> d_isclose '{ x y -> e_nclose (d_isclose x) c_at d_isclose y } r_/ b }

# t as a string literal: in quotes, with the characters a literal
# escapes (quote, backslash, newline, tab) escaped.
q_uote := { t ->
  0 = t_ally t ? "\"\""
  e_ := { c -> c = f_irst "\"" ? "\\\""; c = f_irst "\\" ? "\\\\"; c = f_irst "\n" ? "\\n"; c = f_irst "\t" ? "\\t"; c }
  "\"" c_at (j_oin 'e_ m_ap t) c_at "\""
}

# The template t with each $w replaced by the word w.
c_opy := { t w ->
  h := h_oles t
  g := 0 c_at -1 d_rop h
  p_ := { i -> (i s_elect h) ? w; (i s_elect g) ? ""; i s_elect t }
  d_isclose '{ a b -> e_nclose (d_isclose a) c_at d_isclose b } r_/ 'p_ m_ap r_ange t_ally t
}
