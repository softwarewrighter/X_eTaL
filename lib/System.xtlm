## The system macros (lang-choices MC18, MC19, MC24), loaded before
## every file with no import and no alias: each is called unprefixed,
## as "c" i_f< "a; b". A macro is a function of the source text on each
## side of its call; the text it gives replaces the call. @ on a side
## means the macro takes nothing there (MC22). What only the compiler
## knows comes from hooks (MC20), usable only in a macro body.

### Importing

## Import a library under an alias of your choice: the alias on the
## left (lowercase letters and digits, then a colon), the library's name
## or path on the right. A name Name finds Name.xtl and Name.xtlm
## together, beside the importing file, then in userlibs/, then in each
## directory of XETAL_PATH, then among the standard libraries built
## into xetal; the first place holding either gives both. Their exports
## are then written with the alias (s:m_ean). Built into xetal: it makes
## names exist under the alias, which no macro's text can do (a macro
## gives source, and source can only use names that exist), so it has a
## signature here and no definition.
## >> "s:" u_se< "Stats"
## >> s:m_ean 1 2 3
## 2.0
s:u_se< :: Char -> Char -> Unit

### Choosing and repeating

## The value of the first expression on the right when the condition
## on the left holds, else of the second. The condition is tested when
## the program runs, and only the expression chosen is evaluated
## (MC14).
## >> "2 > 0" i_f< "1; -1"
## 1
s:i_f< := { cond both ->
  p := w_here h:s_eps both
  1 != t_ally p ? "bad-macro-argument right" []R_EJECT ifArgs
  a := h:t_rim ((f_irst p) - 1) t_ake both
  b := h:t_rim (f_irst p) d_rop both
  (0 = t_ally a) | 0 = t_ally b ? "bad-macro-argument right" []R_EJECT ifArgs
  "{ @ -> (" c_at (h:t_rim cond) c_at ") ? " c_at a c_at "; " c_at b c_at " } @"
}

## Run the statements on the right unless the condition on the left
## holds; the value is @ either way (MC15).
## >> "1 = 0" u_nless< "p_rint! 7"
## 7
## @
s:u_nless< := { cond body ->
  "{ @ -> (" c_at (h:t_rim cond) c_at ") ? @; " c_at (h:t_rim body) c_at "; @ } @"
}

## One statement per word on the left, each a copy of the template on
## the right with $w replaced by the word; it stands as a statement of
## its own (MC16).
## >> "m_ax m_in" e_ach< "u:$w/ := { '$w r_/ _r }"
## >> u:m_ax/ 3 1 4
## 4
s:e_ach< := { words template ->
  n_ot []S_TATEMENT @ ? "misplaced-macro call" []R_EJECT eachAlone
  ws := h:w_ords words
  0 = t_ally ws ? "bad-macro-argument left" []R_EJECT "e_ach< needs words on its left"
  0 = '+ r_/ 0 + h:h_oles template ? "bad-macro-argument right" []R_EJECT eachHole
  d_isclose '{ a b -> e_nclose (d_isclose a) c_at "\n" c_at d_isclose b } r_/ '{ w -> template h:c_opy d_isclose w } m_ap ws
}

### What the compiler knows

## The line the call is written on, as a number (inside another
## macro's expansion, the line of that macro's call).
## >> @ l_ine< @
## 1
s:l_ine< := { @ @ -> f_ormat []L_INE @ }

## The file the call is written in, as a string (-e for text given on
## the command line).
## >> @ f_ile< @
## -e
s:f_ile< := { @ @ -> h:q_uote []F_ILE @ }

## The text of a file, as a string, by a path relative to the file the
## call is written in; from the disk at the command line, from the
## store in the browser (Rust's include_str!). For example,
## t := @ i_nclude< "data.txt" binds the text of data.txt.
s:i_nclude< := { @ path -> h:q_uote []I_NCLUDE h:t_rim path }

## 1 when a configuration fact holds, else 0: the platform (cli, or web
## in the browser) or a flag set with xetal --cfg NAME.
## >> @ c_fg< "cli"
## 1
s:c_fg< := { @ name -> f_ormat 0 + []C_FG h:t_rim name }

## Stop with a compile error at the call, with the code on the left and
## the message on the right (Rust's compile_error!); a macro writes it
## into its text to refuse a call.
## >> "too-big" e_rror< "the grid must be at most 9 wide"
## error[too-big]
s:e_rror< := { code message -> ((h:t_rim code) c_at " call") []R_EJECT message }

### Debugging and checking

## The value of the expression on the right, after writing
## [file:line] expr = value to standard error (Rust's dbg!).
## >> 1 + @ d_bg< "2 * 3"
## 7
s:d_bg< := { @ expr ->
  e := h:t_rim expr
  shown := "[" c_at ([]F_ILE @) c_at ":" c_at (f_ormat []L_INE @) c_at "] " c_at e c_at " = "
  "{ v -> []E_RR " c_at (h:q_uote shown) c_at " c_at f_ormat v; v } (" c_at e c_at ")"
}

## When the condition on the left does not hold, write
## assertion failed: cond (message) [file:line] to standard error, the
## condition as written, and go on; the message on the right may be @
## for none. The value is @ either way. Unlike Rust's assert!, it never
## stops the program (p_anic< does).
## >> "1 > 2" a_ssert< "one is not more than two"
## @
s:a_ssert< := { cond note ->
  c := h:t_rim cond
  line := "assertion failed: " c_at c c_at (h:w_hy f_ormat note) c_at " [" c_at ([]F_ILE @) c_at ":" c_at (f_ormat []L_INE @) c_at "]"
  "{ @ -> (" c_at c c_at ") ? @; []E_RR " c_at (h:q_uote line) c_at "; @ } @"
}

### Text

## The text on the right with each {expr} replaced by the value of
## expr, as the function f_ormat writes it; {{ and }} are braces. An
## unclosed {, an empty {} or a lone } fails before the program runs
## (Rust's format!).
## >> @ f_ormat< "two and two: {2 + 2} {{four}}"
## two and two: 4 {four}
s:f_ormat< := { @ t -> h:o_rEmpty h:p_ieces t }

## Stop the program with error[panic] and the message on the right,
## formatted as f_ormat< does, at the call; it stands where any value
## may (Rust's panic!).
## >> 1 + @ p_anic< "no {1 + 1}"
## error[panic]
s:p_anic< := { @ t -> "[]P_ANIC (" c_at (h:o_rEmpty h:p_ieces t) c_at ")" }

## Stop the program with error[panic] and the message
## "not yet implemented: " followed by the text on the right (formatted
## as f_ormat< does); a placeholder for code still to write, standing
## where any value may (Rust's todo!).
## >> 1 + @ t_odo< "the size check"
## error[panic]
s:t_odo< := { @ t -> "@ p_anic< " c_at h:q_uote "not yet implemented: " c_at t }

### Errors

## Run the statements on the left under a trap: when they stop with an
## error, the handler on the right runs with the error as e and
## answers an outcome (r_ecover<, r_etry<, h_alt<, c_ontinue<, or a
## c_atch< choosing among them); the value is the body's or the
## recovery. Both sides are written as lambda bodies ([]T_RAP).
## binds: e
## >> "1 d_iv 0" t_ry< "@ r_ecover< \"-1\""
## -1
s:t_ry< := { body handler ->
  "'{ @ -> " c_at (h:t_rim body) c_at " } []T_RAP '{ e -> " c_at (h:t_rim handler) c_at " }"
}

## In a handler: the outcome on the right for an error whose code is
## one of the words on the left, and h_alt< for any other error.
## >> "\"io\" []S_IGNAL \"gone\"" t_ry< "\"io empty\" c_atch< \"@ r_ecover< \\\"0\\\"\""
## 0
s:c_atch< := { codes outcome ->
  ws := h:w_ords codes
  0 = t_ally ws ? "bad-macro-argument left" []R_EJECT catchCodes
  tests := h:j_oin '{ w -> h:m_atchCode d_isclose w } m_ap ws
  "(" c_at (((t_ally tests) - 3) t_ake tests) c_at ") ? " c_at (h:t_rim outcome) c_at "; []H_ALT e"
}

## Run the statements on the left, then the cleanup on the right,
## whether the body gave a value or an error; the value is the body's,
## or its error going on ([]E_NSURE).
## >> "p_rint! 1; 2" f_inally< "p_rint! \"cleaned\""
## 1
## cleaned
## 2
s:f_inally< := { body cleanup ->
  "'{ @ -> " c_at (h:t_rim body) c_at " } []E_NSURE '{ @ -> " c_at (h:t_rim cleanup) c_at " }"
}

## In a handler: recover with the value on the right, of the body's
## type; the try's value is this one ([]R_ECOVER). The right side is
## code, like every macro argument: to recover with a string, write a
## string literal there, its quotes escaped once more inside t_ry<.
## >> "1 d_iv 0" t_ry< "@ r_ecover< \"2 + 2\""
## 4
##
## >> "\"io\" []S_IGNAL \"gone\"" t_ry< "@ r_ecover< \"\\\"none\\\"\""
## none
s:r_ecover< := { @ value -> "[]R_ECOVER (" c_at (h:t_rim value) c_at ")" }

## In a handler: run the body again (at most 1000 times; []R_ETRY).
## >> n! := 0
## >> "n! := n! + 1; n! < 3 ? \"again\" []S_IGNAL \"not yet\"; n!" t_ry< "@ r_etry< @"
## 3
s:r_etry< := { @ @ -> "[]R_ETRY e" }

## In a handler: let the error go on as it was ([]H_ALT).
## >> "1 d_iv 0" t_ry< "@ h_alt< @"
## error[division-by-zero]
s:h_alt< := { @ @ -> "[]H_ALT e" }

## In a handler: go on from a warning ([]W_ARN) with its value
## ([]C_ONTINUE).
## >> "10 + (0 []W_ARN \"empty\" \"nothing\")" t_ry< "@ c_ontinue< @"
## 10
s:c_ontinue< := { @ @ -> "[]C_ONTINUE e" }

### Private helpers

catchCodes := "c_atch< needs error codes on its left: \"io\" c_atch< \"@ r_ecover< \\\"0\\\"\""

# One test of the error's code against the word w, with the | that
# joins it to the next.
h:m_atchCode := { w -> "(([]E_CODE e) m_atch " c_at (h:q_uote w) c_at ") | " }


ifArgs := "i_f< takes two expressions on its right, separated by ;: \"c\" i_f< \"a; b\""
eachAlone := "e_ach< writes statements: it stands as a statement of its own"
eachHole := "an e_ach< template names the word as $w: \"a b\" e_ach< \"u:$w := 1\""

# The text t without white space at its ends.
h:t_rim := { t ->
  m := n_ot t m_ember? " \n\t"
  0 = '+ r_/ 0 + m ? ""
  i := w_here m
  (1 + (f_irst r_ev i) - f_irst i) t_ake ((f_irst i) - 1) d_rop t
}

# The words of t: runs of characters other than white space, boxed.
h:w_ords := { t -> (n_ot t m_ember? " \n\t") p_artition t }

# Where t separates statements: a ; or a newline outside brackets and
# strings.
h:s_eps := { t ->
  q := ('+ s_\ 0 + t = f_irst "\"") m_od 2
  d := '+ s_\ (0 + t m_ember? "([{") - 0 + t m_ember? ")]}"
  (t m_ember? ";\n") & (0 = d) & 0 = q
}

# Where $w starts in t.
h:h_oles := { t -> (t = f_irst "$") & (1 d_rop t = f_irst "w") c_at 0 }

# The boxed texts b joined into one text.
h:j_oin := { b -> d_isclose '{ x y -> e_nclose (d_isclose x) c_at d_isclose y } r_/ b }

# t as a string literal: in quotes, with the characters a literal
# escapes (quote, backslash, newline, tab) escaped.
h:q_uote := { t ->
  0 = t_ally t ? "\"\""
  e_ := { c -> c = f_irst "\"" ? "\\\""; c = f_irst "\\" ? "\\\\"; c = f_irst "\n" ? "\\n"; c = f_irst "\t" ? "\\t"; c }
  "\"" c_at (h:j_oin 'e_ m_ap t) c_at "\""
}

# The template t with each $w replaced by the word w.
h:c_opy := { t w ->
  h := h:h_oles t
  g := 0 c_at -1 d_rop h
  p_ := { i -> (i s_elect h) ? w; (i s_elect g) ? ""; i s_elect t }
  h:j_oin 'p_ m_ap r_ange t_ally t
}

# An assertion's message in parentheses; none for @ (as f_ormat writes
# it).
h:w_hy := { m -> "@" m_atch m ? ""; " (" c_at m c_at ")" }

# Source p, or an empty string literal when there is none.
h:o_rEmpty := { p -> 0 = t_ally p ? "\"\""; p }

# t as a string literal, or nothing when it is empty.
h:l_it := { t -> 0 = t_ally t ? ""; h:q_uote t }

# Two pieces of source joined by c_at (either may be missing).
h:c_j := { a b -> 0 = t_ally a ? b; 0 = t_ally b ? a; a c_at " c_at " c_at b }

# The format text t as source: its literal text quoted, each {expr} as
# (f_ormat (expr)), joined by c_at; {{ and }} are braces.
h:p_ieces := { t ->
  b := t m_ember? "{}"
  0 = '+ r_/ 0 + b ? h:l_it t
  k := f_irst w_here b
  pre := (k - 1) t_ake t
  c := k s_elect t
  rest := k d_rop t
  n := (k + 1) s_elect t c_at " "
  c = n ? (h:l_it pre c_at c) h:c_j h:p_ieces 1 d_rop rest
  c = f_irst "}" ? "bad-format right" []R_EJECT "a } in a format text is written }}"
  e := w_here rest = f_irst "}"
  0 = t_ally e ? "bad-format right" []R_EJECT "an unclosed { in a format text"
  x := h:t_rim ((f_irst e) - 1) t_ake rest
  0 = t_ally x ? "bad-format right" []R_EJECT "an empty {} in a format text: write {expr}, or {{ for a brace"
  (h:l_it pre) h:c_j ("(f_ormat (" c_at x c_at "))") h:c_j h:p_ieces (f_irst e) d_rop rest
}
