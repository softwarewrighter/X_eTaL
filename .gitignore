# cargo
/target/
**/*.rs.bk

# reg-rs: .rgt + .out baselines are committed; .tdb* files are caches
/reg/*.tdb*

# agentrail raw session transcripts (large, local only)
.agentrail/sessions/*.jsonl
.agentrail-archive/*/sessions/*.jsonl

# Claude Code local state (shared slash commands may live in .claude/commands/)
.claude/*
!.claude/commands/

# editors and OS
.idea/
.vscode/
*.swp
*~
.DS_Store

# local scratch
/tmp/

# Scratch output of demos (for example the TTTML model): not tracked
work/
tools/katex/node_modules/

# The site's local build area (scripts/build-pages.sh); published to the
# gh-pages branch by scripts/publish-pages.sh, not tracked on main.
/pages/

# trunk serve output (just serve); the published copy is pages/
components/web/crates/xetal-web/dist/
__pycache__/
# interpreters built by scripts/install-array-langs.sh
tools/bin/
tools/src/

# The uv environment scripts/py runs Python from (uv venv).
/.venv/
