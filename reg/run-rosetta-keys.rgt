command = "rm -rf work/reg-keys && env XETAL_PATH=demos/rosetta ./target/release/xetal run demos/rosetta/rosetta.xtl --events reg/fixtures/rosetta-keys.txt --draw work/reg-keys"
exit_code = 0
desc = "the Rosetta stone run on a scripted queue of keys (step 8): a frame per tick (8 frames), the top ring stepped right, the drum rolled down, the bottom ring stepped left, the top paused and resumed by the space bar written both ways; the state at the end"
