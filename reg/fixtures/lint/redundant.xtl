#!/usr/bin/env xetal
# redundant-lambda: a lambda that only passes its arguments on is the quoted name.
u:s_q := { _r * _r }
u:n_ot := { x -> n_eg x }
v := 1 2 3
'{ x -> n_eg x } e_ach v
'{ a b -> a + b } r_/ v
'{ x -> u:s_q x } e_ach v
'{ x -> x } e_ach v
'{ a b -> b - a } r_/ v
'{ x -> x * 2 } e_ach v
