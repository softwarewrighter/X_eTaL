#!/usr/bin/env xetal
# The Rosetta stone's state machine (demos/rosetta/Comparison.xtl)
# checked as transitions, each line a claim from docs/rosetta.md: run
# with XETAL_PATH=demos/rosetta. Every line should print 1.
"cm:" u_se< "Comparison"
s0 := 31 cm:s_tart 7
xk := (cm:BOTTOM c_at 5.0) cm:c_hoose (cm:TOP c_at 7.0) cm:c_hoose s0
u:c_urrents := { s -> (cm:IDIOM cm:c_urrent s) c_at (cm:TOP cm:c_urrent s) c_at cm:BOTTOM cm:c_urrent s }

# choosing an idiom keeps both languages
(u:c_urrents (cm:IDIOM c_at 8.0) cm:c_hoose xk) m_atch 8 7 5
# choosing a pair sets the bottom only
(u:c_urrents (cm:BOTTOM c_at 3.0) cm:c_hoose xk) m_atch 1 7 3
# top and bottom never equal: choosing the top's language below changes nothing
(u:c_urrents (cm:BOTTOM c_at 7.0) cm:c_hoose xk) m_atch 1 7 5
# stepping onto the other ring's language steps past it
(u:c_urrents (cm:BOTTOM c_at 1.0) cm:s_tep (cm:BOTTOM c_at 6.0) cm:c_hoose xk) m_atch 1 7 1
# a choice turns the short way round: 7 from 1 is one step back
((cm:TOP c_at cm:STEPS) cm:a_t xk) = -1.0
# a paused top stays paused while the bottom turns
paused := cm:TOP cm:t_oggle s0
((cm:TOP c_at cm:PLAYING) cm:a_t (cm:BOTTOM c_at 1.0) cm:s_tep paused) = 0.0
((cm:BOTTOM c_at cm:PLAYING) cm:a_t (cm:BOTTOM c_at 1.0) cm:s_tep paused) = 1.0
# a step changes the truth at once and the angle only on ticks
stepped := (cm:TOP c_at 1.0) cm:s_tep s0
((cm:TOP c_at cm:ANGLE) cm:a_t stepped) = 0.0
((cm:TOP c_at cm:ANGLE) cm:a_t (cm:TOP c_at 0.25) cm:e_ase stepped) = 45.0
((cm:TOP c_at cm:ANGLE) cm:a_t cm:s_ettle stepped) = 90.0
# a tick eases every axis and never moves one at rest (the first three rows are the axes)
(3 t_ake 0.1 cm:t_ick s0) m_atch 3 t_ake s0
# the idiom axis wraps both ways
(cm:IDIOM cm:c_urrent (cm:IDIOM c_at -1.0) cm:s_tep s0) = 31
(cm:IDIOM cm:c_urrent (cm:IDIOM c_at 31.0) cm:s_tep s0) = 1
# a drag of the top turns the top only; the bottom's angle is unchanged
drag := 142.0 50.0 cm:m_ove 100.0 50.0 cm:d_own s0
((cm:TOP c_at cm:ANGLE) cm:a_t drag) = -18.0
((cm:BOTTOM c_at cm:ANGLE) cm:a_t drag) = 0.0
# a drag does not pause the half for good; it resets the idle clock
((cm:TOP c_at cm:PLAYING) cm:a_t drag) = 1.0
((cm:ATTRACT c_at cm:IDLE) cm:a_t cm:t_ouched 2.0 cm:t_ick s0) = 0.0
# a vertical drag anywhere rolls the drum, and the halves stay put
roll := 100.0 92.0 cm:m_ove 100.0 50.0 cm:d_own s0
((cm:IDIOM c_at cm:ANGLE) cm:a_t roll) = -18.0
((cm:TOP c_at cm:ANGLE) cm:a_t roll) = 0.0
# the axis is decided by the first real move and kept: a later vertical move still turns the top
kept := 142.0 100.0 cm:m_ove drag
((cm:TOP c_at cm:ANGLE) cm:a_t kept) = -18.0
((cm:IDIOM c_at cm:ANGLE) cm:a_t kept) = 0.0
# release snaps to the nearest item (a slow drag of less than half a face goes back)
((cm:TOP c_at cm:STEPS) cm:a_t 125.0 50.0 cm:u_p 125.0 50.0 cm:m_ove 120.0 50.0 cm:m_ove 100.0 50.0 cm:d_own s0) = 0.0
# a flick carries one item further
((cm:TOP c_at cm:STEPS) cm:a_t 142.0 50.0 cm:u_p drag) = -1.0
# a click without movement toggles the half under it, and a click on the top never touches the bottom
((cm:BOTTOM c_at cm:PLAYING) cm:a_t 100.0 300.0 cm:u_p 100.0 300.0 cm:d_own s0) = 0.0
((cm:TOP c_at cm:PLAYING) cm:a_t 100.0 300.0 cm:u_p 100.0 300.0 cm:d_own s0) = 1.0
((cm:TOP c_at cm:PLAYING) cm:a_t 100.0 50.0 cm:c_lick s0) = 0.0
# a move with nothing pressed changes nothing
(100.0 50.0 cm:m_ove s0) m_atch s0
# attract: the bottom steps at each dwell, the drum rolls after a sweep of six (the other languages), the top only after every idiom (31 x 6 = 186 steps)
(cm:BOTTOM cm:c_urrent cm:a_ttract s0) = 2
((cm:IDIOM cm:c_urrent cm:a_ttract^5 s0) c_at cm:IDIOM cm:c_urrent cm:a_ttract^6 s0) m_atch 1 2
((cm:IDIOM cm:c_urrent cm:a_ttract^11 s0) c_at cm:IDIOM cm:c_urrent cm:a_ttract^12 s0) m_atch 2 3
(cm:TOP cm:c_urrent 36 'cm:a_ttract p_ower s0) = 1
((cm:TOP cm:c_urrent 185 'cm:a_ttract p_ower s0) c_at cm:TOP cm:c_urrent 186 'cm:a_ttract p_ower s0) m_atch 1 2
# the rings never coincide while sweeping: 12 steps never put the bottom on the top's language
'* r_/ '{ k -> (cm:TOP cm:c_urrent k 'cm:a_ttract p_ower s0) != cm:BOTTOM cm:c_urrent k 'cm:a_ttract p_ower s0 } e_ach r_ange 12
# a paused half is counted but not turned
((cm:BOTTOM cm:c_urrent cm:a_ttract^2 cm:BOTTOM cm:t_oggle s0) c_at cm:IDIOM cm:c_urrent cm:a_ttract^6 cm:BOTTOM cm:t_oggle s0) m_atch 1 2
# ticks: nothing moves before a dwell, the bottom steps at the dwell, and a touch (any event but a tick) holds the stone still for the idle time
(cm:BOTTOM cm:c_urrent (cm:dwell - 0.1) cm:t_ick s0) = 1
(cm:BOTTOM cm:c_urrent cm:dwell cm:t_ick s0) = 2
(cm:BOTTOM cm:c_urrent (cm:idleBefore - 0.1) cm:t_ick cm:t_ouched s0) = 1
(cm:BOTTOM cm:c_urrent cm:idleBefore cm:t_ick cm:t_ouched s0) = 2
