command = '''rm -rf work/doc-site-links && ./target/debug/xetal doc --out work/doc-site-links components/doc/fixtures/app.xtl >/dev/null && grep -o 'id="[^"]*"\|href="[^"]*"' work/doc-site-links/components-doc-fixtures-Greet.xtl.html'''
exit_code = 0
desc = "xetal doc --out: a library page's anchors and links: the side bar, sections with a table of contents, each item linked to its source line, what it uses (items, private names, built-ins) and where it is used (another file's item)"
