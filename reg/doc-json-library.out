{
  "files": [
    {
      "name": "lib/Stats.xtl",
      "kind": "library",
      "doc": "Stats: a small statistics library (a standard library, built into\nxetal). Import it with an alias of your choice: \"s:\" u_se< \"Stats\".\nIt is a demo library, loaded only by that import: a small subset of\nX_eTaL-libraries' Statistics, which has much more (a program may use\neither).\nNames with l: are exported; names with h: are private to this file.",
      "imports": [],
      "expansions": [],
      "items": [
        {
          "name": "l:m_ean",
          "kind": "function",
          "public": true,
          "type": "Num a => a -> Float",
          "line": 14,
          "section": "Center",
          "doc": "The arithmetic mean, of Int or Float numbers.",
          "examples": [{"code": "\"s:\" u_se< \"Stats\"", "output": ""}, {"code": "s:m_ean 2 4 4 4 5 5 7 9", "output": "5.0"}],
          "binds": [],
          "source": "l:m_ean := [[f_loat '+ r_/] / [f_loat t_ally]]",
          "uses": []
        },
        {
          "name": "h:s_quare",
          "kind": "function",
          "public": false,
          "type": "Num a => a -> a",
          "line": 17,
          "section": "Center",
          "doc": "Each number times itself.",
          "examples": [],
          "binds": [],
          "source": "h:s_quare := { _r * _r }                  # private: not visible outside",
          "uses": []
        },
        {
          "name": "h:d_eviations",
          "kind": "function",
          "public": false,
          "type": "Num a => a -> Float",
          "line": 19,
          "section": "Center",
          "doc": "How far each number is from the mean, as Floats.",
          "examples": [],
          "binds": [],
          "source": "h:d_eviations := [f_loat - l:m_ean]",
          "uses": [{"written": "l:m_ean", "file": "lib/Stats.xtl", "item": "l:m_ean"}]
        },
        {
          "name": "l:v_ariance",
          "kind": "function",
          "public": true,
          "type": "Num a => a -> Float",
          "line": 27,
          "section": "Spread",
          "doc": "The variance: the mean squared deviation from the mean.",
          "examples": [{"code": "\"s:\" u_se< \"Stats\"", "output": ""}, {"code": "s:v_ariance 2 4 4 4 5 5 7 9", "output": "4.0"}],
          "binds": [],
          "source": "l:v_ariance := [l:m_ean [h:s_quare h:d_eviations]]",
          "uses": [{"written": "h:d_eviations", "file": "lib/Stats.xtl", "item": "h:d_eviations"}, {"written": "h:s_quare", "file": "lib/Stats.xtl", "item": "h:s_quare"}, {"written": "l:m_ean", "file": "lib/Stats.xtl", "item": "l:m_ean"}]
        },
        {
          "name": "l:s_d",
          "kind": "function",
          "public": true,
          "type": "Num a => a -> Float",
          "line": 33,
          "section": "Spread",
          "doc": "The standard deviation: the square root of the variance.",
          "examples": [{"code": "\"s:\" u_se< \"Stats\"", "output": ""}, {"code": "s:s_d 2 4 4 4 5 5 7 9", "output": "2.0"}],
          "binds": [],
          "source": "l:s_d := { (l:v_ariance _r) ^ 0.5 }",
          "uses": [{"written": "l:v_ariance", "file": "lib/Stats.xtl", "item": "l:v_ariance"}]
        },
        {
          "name": "l:r_ange",
          "kind": "function",
          "public": true,
          "type": "Num a => a -> a",
          "line": 39,
          "section": "Spread",
          "doc": "The range: the largest minus the smallest.",
          "examples": [{"code": "\"s:\" u_se< \"Stats\"", "output": ""}, {"code": "s:r_ange 2 4 4 4 5 5 7 9", "output": "7"}],
          "binds": [],
          "source": "l:r_ange := ['m_ax r_/ - 'm_in r_/]",
          "uses": []
        }
      ]
    }
  ]
}

