{
  "files": [
    {
      "name": "lib/Stats.xtl",
      "kind": "library",
      "doc": "Stats: a small statistics library (a standard library, built into\nxetal). Import it with an alias of your choice: \"s:\" u_se< \"Stats\".\nNames with l: are exported; the others are private to this file.",
      "imports": [],
      "expansions": [],
      "items": [
        {
          "name": "l:m_ean",
          "kind": "function",
          "public": true,
          "type": "Num a => a -> Float",
          "line": 9,
          "section": null,
          "doc": "The arithmetic mean, of Int or Float numbers.",
          "examples": [{"code": "\"s:\" u_se< \"Stats\"", "output": ""}, {"code": "s:m_ean 2 4 4 4 5 5 7 9", "output": "5.0"}],
          "binds": [],
          "source": "l:m_ean := [[f_loat '+ r_/] / [f_loat t_ally]]",
          "uses": []
        },
        {
          "name": "s_quare",
          "kind": "function",
          "public": false,
          "type": "Num a => a -> a",
          "line": 11,
          "section": null,
          "doc": null,
          "examples": [],
          "binds": [],
          "source": "s_quare := { _r * _r }                  # private: not visible outside",
          "uses": []
        },
        {
          "name": "d_eviations",
          "kind": "function",
          "public": false,
          "type": "Num a => a -> Float",
          "line": 12,
          "section": null,
          "doc": null,
          "examples": [],
          "binds": [],
          "source": "d_eviations := [f_loat - l:m_ean]",
          "uses": [{"written": "l:m_ean", "file": "lib/Stats.xtl", "item": "l:m_ean"}]
        },
        {
          "name": "l:v_ariance",
          "kind": "function",
          "public": true,
          "type": "Num a => a -> Float",
          "line": 18,
          "section": null,
          "doc": "The variance: the mean squared deviation from the mean.",
          "examples": [{"code": "\"s:\" u_se< \"Stats\"", "output": ""}, {"code": "s:v_ariance 2 4 4 4 5 5 7 9", "output": "4.0"}],
          "binds": [],
          "source": "l:v_ariance := [l:m_ean [s_quare d_eviations]]",
          "uses": [{"written": "d_eviations", "file": "lib/Stats.xtl", "item": "d_eviations"}, {"written": "l:m_ean", "file": "lib/Stats.xtl", "item": "l:m_ean"}, {"written": "s_quare", "file": "lib/Stats.xtl", "item": "s_quare"}]
        },
        {
          "name": "l:s_d",
          "kind": "function",
          "public": true,
          "type": "Num a => a -> Float",
          "line": 24,
          "section": null,
          "doc": "The standard deviation: the square root of the variance.",
          "examples": [{"code": "\"s:\" u_se< \"Stats\"", "output": ""}, {"code": "s:s_d 2 4 4 4 5 5 7 9", "output": "2.0"}],
          "binds": [],
          "source": "l:s_d := { (l:v_ariance _r) ^ 0.5 }",
          "uses": [{"written": "l:v_ariance", "file": "lib/Stats.xtl", "item": "l:v_ariance"}]
        },
        {
          "name": "l:r_ange",
          "kind": "function",
          "public": true,
          "type": "Num a => a -> a",
          "line": 30,
          "section": null,
          "doc": "The range: the largest minus the smallest.",
          "examples": [{"code": "\"s:\" u_se< \"Stats\"", "output": ""}, {"code": "s:r_ange 2 4 4 4 5 5 7 9", "output": "7"}],
          "binds": [],
          "source": "l:r_ange := ['m_ax r_/ - 'm_in r_/]",
          "uses": []
        }
      ]
    }
  ]
}

