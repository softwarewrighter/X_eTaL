command = '''rm -rf work/doc-site-system && ./target/debug/xetal doc --out work/doc-site-system demos/macros.xtl >/dev/null && grep -o '<h2 class="section"[^>]*>[^<]*</h2>\|<div class="item" id="[^"]*"\|<pre class="example">' work/doc-site-system/std-System.xtlm.html'''
exit_code = 0
desc = "xetal doc --out: the system macros page of a program that calls them: its ### sections, each item anchored, the ## >> examples drawn"
