command = 'rm -rf work/reg-stone && env XETAL_PATH=demos/rosetta ./target/release/xetal run demos/rosetta/rosetta.xtl --events reg/fixtures/rosetta-rest.txt --draw work/reg-stone && cat work/reg-stone/rosetta-1.svg'
exit_code = 0
desc = "the Rosetta stone at rest (one tick): Rotate, X_eTaL over ngn/k, with BQN and Uiua on the right sides and Reverse on top (the axes alphabetical); the two halves and their text, painted far to near, as the picture is written"
