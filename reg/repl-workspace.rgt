command = '''printf 'x := 3\ncount! := 0\nu:f_ := { a b -> a + (10 * b) }\n## u:p_air a: a beside itself.\nu:p_air := { a ->\n  (a, a) }\n)fns\n)vars\n)def u:p_air\n)def y\n)save\n4 u:f_ 2\n' | ./target/debug/xetal repl'''
exit_code = 0
desc = "workspace commands in a piped REPL session: )fns and )vars list the session's names with their types, )def shows a definition drawn with its doc comment and type; an unknown command or name is an error and the session goes on"
