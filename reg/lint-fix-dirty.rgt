command = "mkdir -p work && cp reg/fixtures/lint/redundant.xtl work/lint-fix-dirty.xtl && ./target/debug/xetal lint --fix work/lint-fix-dirty.xtl; cmp -s reg/fixtures/lint/redundant.xtl work/lint-fix-dirty.xtl && echo unchanged"
exit_code = 0
desc = "--fix refuses a file that is not committed as it is (a copy in work/, ignored by git), leaving it unchanged: --allow-dirty overrides"
