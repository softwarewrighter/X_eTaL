l:n_othing : (Any a, Any b) => a -> b -> a
l:j_ust : (Any a, Any b, Any c) => a -> b -> (a -> c) -> c
l:m_aybe : (Any a, Any b, Any c) => a -> b -> (b -> a -> c) -> c
l:o_r : (Any a, Any b, Any c) => a -> (a -> (b -> b) -> c) -> c
l:m_ap : (Any a, Any b, Any c, Any d, Any e, Any f, Any g) => (a -> b) -> ((c -> d -> c) -> (a -> e -> (b -> f) -> f) -> g) -> g
l:b_ind : (Any a, Any b, Any c, Any d) => a -> ((b -> c -> b) -> a -> d) -> d
