Available recipes:
    animate                    # Play the rotate demo (demos/rotate.xtl) as an animation
    asks                       # Regenerate docs/asks.md (the sibling repos' asks and their state here), running each repro
    bench RUNS="3"             # Time the benchmarks (bench/*.xtl and three demos), best of RUNS, as a table for docs/speed.md
    bench-bless RUNS="5"       # Record this machine's benchmark baseline (blessing a slowdown needs the user's approval)
    bench-check RUNS="5"       # Check the benchmarks against this machine's baseline: fails when one is more than 15% slower
    build                      # Build every component (debug) into the shared target/
    build-release              # Build every component optimized (target/release/xetal: the run recipes use it)
    check-literate             # The literate documents' recorded results are current
    check-live                 # Are the live demos live? Fetch every github.io link in the six repositories' READMEs (network)
    clippy                     # Lint every component (warnings are errors)
    default                    # List the recipes
    diagrams                   # Regenerate the annotated diagrams (images/*-annotated.svg) from docs/diagrams/*.notes
    doc                        # Build the documentation site of lib/ and two programs (xetal doc) into pages/doc
    draw file                  # Run a program that draws ([]S_HOW), then open its first picture in the browser
    edit file                  # Edit a file with the live decorated view: just edit demos/life.xtl
    eval +args                 # Evaluate an expression, flags first: just eval --echo "'+ r_/ 1 2 3"
    fmt                        # Format every component
    gate *FLAGS                # The gate: sample (end to end, about 30 s) by default; --affected adds what the change touches; --full everything
    idioms                     # Regenerate docs/idioms.md from docs/idioms.template.md and the stone's data
    install dir="~/.local/bin" # Build optimized and install xetal and x_etal into a PATH directory (for #! scripts)
    life                       # Life: a blinker and a glider, stepped (demos/life.xtl)
    literate                   # Run the literate documents (docs/literate/*.org), recording each block's result
    literate-html              # Export the literate documents to HTML under pages/literate/ (with an index page)
    locks *args                # Check (or with --fix, regenerate) the component Cargo.lock files
    name-image                 # Draw images/name-forms.png, the name every way (docs/name.md, the live demo's Help)
    nightly                    # The nightly full gate: pull main, run everything, keep the log, open an issue on failure
    pages *PARTS               # Build pages/ (committed; the Pages workflow publishes it): only the parts whose inputs changed; `just pages --all` rebuilds everything
    pp file                    # Pretty-print a file like cat: decorated and highlighted (errors in red)
    reference                  # Regenerate docs/reference.md (every built-in, its examples run) from docs/reference/builtins.ref
    reg                        # Run the reg-rs CLI goldens in reg/
    repl                       # Start the interactive session
    rosetta-check              # Check the Rosetta stone's data: names, keys, and every X_eTaL cell runs
    run +args                  # Type-check and run a script, flags first: just run --echo demos/tour.xtl
    screenshots                # Regenerate the README / docs images (vhs, ImageMagick)
    show file                  # Run a file as a notebook: each statement pretty-printed, then its output (#! flags such as --untyped apply)
    slow-show file delay="500" # A notebook run that pauses after each statement (ms, default 500): for watching or recording
    status                     # Regenerate docs/status.md (what works today) from the catalog, decisions, spec cases and libraries
    stop-serve                 # Stop a trunk serve left running (it rebuilds on every change and slows every build and gate)
    test                       # Run every component's tests
    test-emacs                 # The Emacs mode and Org Babel language, with ERT in a batch Emacs (skipped without Emacs)
    tour                       # The language tour: every feature, commented, each line with its output
    tttml                      # TTTML: a machine that learns tic-tac-toe by playing itself, as a notebook (optimized build)
    tttml-play                 # TTTML part 2: play the saved model (run tttml-train first); you are X
    tttml-train                # TTTML part 1: learn tic-tac-toe by playing itself and save the model in work/
    videos                     # Regenerate the videos (vhs, ffmpeg, gif2webp)
    web                        # Serve the live demo locally (http://127.0.0.1:8490/), rebuilt when a source changes [alias: serve]
