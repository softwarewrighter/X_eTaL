command = '''./target/release/xetal run --seed 1 demos/tttml-train.xtl > /dev/null && printf '5\nx\n5\n1\n3\n4\n8\n9\n' | ./target/release/xetal run demos/tttml-play.xtl'''
exit_code = 0
desc = "TTTML parts 1 and 2: train and save the model, then play it with typed moves (a bad move is asked for again)"
