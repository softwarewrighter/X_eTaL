command = """./target/debug/xetal eval -e 'p_rint! @ i_nclude< "spec/macros/data/hello.txt"' && ./target/debug/xetal expand -e 't := @ i_nclude< "spec/macros/data/hello.txt"'"""
exit_code = 0
desc = "@ i_nclude< \"path\" reads a file (relative to the program; -e text: the current directory) into a string literal while expanding"
