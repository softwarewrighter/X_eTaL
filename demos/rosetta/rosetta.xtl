#!/usr/bin/env xetal
# The Rosetta stone (docs/rosetta.md): how languages write the same
# idiom, on an impossible object. The whole stone rolls through the
# idioms; its top half turns through the languages; its bottom half
# turns, on its own, through the languages compared with. The data is
# demos/rosetta/data.toml, read as aligned arrays over the two axes;
# the state machine is Comparison.xtl, the geometry Stone.xtl. The
# program runs on events ([]E_VENT): each tick eases the axes and
# shows a frame; keys turn the axes (Up/Down the idioms, Left/Right
# the top language, a/d the bottom; space, s, w pause a half or the
# drum); the end of the events prints the state and stops.
"cm:" u_se< "Comparison"
"st:" u_se< "Stone"
"v:" u_se< "Svg"

data := "demos/rosetta/data.toml"
idioms := data []L_IST "idioms"
idiomNames := data []L_IST "idiom_names"
languages := data []L_IST "languages"
languageNames := data []L_IST "language_names"
u:t_able := { name -> ((e_nclose data) c_at e_nclose name) []T_ABLE "idioms" "languages" }
source := u:t_able "source"
output := u:t_able "output"
notes := u:t_able "notes"
spans := u:t_able "spans"

# The colors of code on a face, by class: X_eTaL's classes as []V_IEW
# names them, and the same names for the spans other languages' cells
# may carry in data.toml.
u:c_olor := { class ->
  class m_atch "builtin" ? "#1d4ed8"
  class m_atch "userfunc" ? "#7c3aed"
  class m_atch "libfunc" ? "#7c3aed"
  class m_atch "macro" ? "#7c3aed"
  class m_atch "number" ? "#b45309"
  class m_atch "string" ? "#15803d"
  class m_atch "symbol" ? "#111827"
  class m_atch "comment" ? "#6b7280"
  class m_atch "lambdaarg" ? "#0f766e"
  class m_atch "keyword" ? "#1d4ed8"
  class m_atch "function" ? "#1d4ed8"
  class m_atch "operator" ? "#111827"
  class m_atch "name" ? "#000000"
  "#000000"
}

# Runs of classified text (an n x 2 matrix of boxed texts, text then
# class) as colored markup for a face.
u:r_uns := { m -> u:j_oin '{ k -> (u:c_olor d_isclose 2 s_elect k s_elect m) v:s_pan d_isclose 1 s_elect k s_elect m } m_ap r_ange 1 s_elect s_hape m }

# The classes of a cell that has no spans of its own, guessed from its
# characters, as the same n x 2 matrix: digits are
# numbers, letters and the underscore names, spaces plain, and
# everything else a built-in, which in an array language's glyphs is
# nearly always right. Runs of one class are one span; the work is
# all primitives (one lambda per run, not per character).
u:g_uess := { src ->
  cls := (src m_ember? "0123456789") + (2 * src m_ember? "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_") + 3 * src = f_irst " "
  starts := 1 c_at (1 d_rop cls) != -1 d_rop cls
  runs := ('+ s_\ starts) p_artition src
  kinds := (e_nclose "builtin") c_at (e_nclose "number") c_at (e_nclose "name") c_at e_nclose "plain"
  classes := (1 + (w_here starts) s_elect cls) s_elect kinds
  o_\ (2 c_at t_ally runs) r_eshape runs c_at classes
}

# A cell's spans from data.toml, "class text|class text|...", as the
# same n x 2 matrix; a cell without spans has its classes guessed.
u:s_pans := { src spans ->
  0 = t_ally spans ? u:g_uess src
  pieces := (n_ot spans = f_irst "|") p_artition spans
  o_ne := { p -> t := d_isclose p; cut := t i_ndexOf f_irst " "; (e_nclose cut d_rop t) c_at e_nclose (cut - 1) t_ake t }
  ((t_ally pieces) c_at 2) r_eshape d_isclose '{ x y -> e_nclose (d_isclose x) c_at d_isclose y } r_/ 'o_ne m_ap pieces
}

# The source of a cell as colored markup: X_eTaL source through
# []V_IEW (so the coloring is the language's own), any other through
# the cell's spans when it has them.
u:c_olored := { il src ->
  i := 1 s_elect il
  l := 2 s_elect il
  (d_isclose l s_elect languages) m_atch "xetal" ? u:r_uns []V_IEW src
  u:r_uns src u:s_pans d_isclose l s_elect i s_elect spans
}

# How many characters a line of code fits at full size (the code is a
# tenth of the face high and about 0.6 as wide), and the smallest the
# code may get.
fits := 15
smallest := 0.05

# A line of markup of n visible characters, shrunk to fit the face when
# it is longer than fits characters (never below smallest).
u:f_itted := { n markup ->
  n <= fits ? markup
  size := 0.1 * (f_loat fits) / f_loat n
  (size m_ax smallest) v:s_ized markup
}

# Source too long for one line split in two at the space nearest its
# middle, as a box of one or two texts (a text without spaces stays
# whole, however long).
u:s_plit := { src ->
  n := t_ally src
  n <= fits ? e_nclose src
  spaces := w_here src = f_irst " "
  0 = t_ally spaces ? e_nclose src
  away := a_bs (2 * spaces) - n
  cut := (away i_ndexOf 'm_in r_/ away) s_elect spaces
  (e_nclose (cut - 1) t_ake src) c_at e_nclose cut d_rop src
}

# Words (a box of texts) as lines of at most width characters, as a box
# of texts; a word longer than the width is a line of its own.
u:l_ines := { width ws ->
  0 = t_ally ws ? ws
  lens := '{ b -> t_ally d_isclose b } e_ach ws
  room := width >= (('+ s_\ lens) + r_ange t_ally ws) - 1
  k := 1 m_ax '+ r_/ room
  line := d_isclose '{ x y -> e_nclose (d_isclose x) c_at " " c_at d_isclose y } r_/ k t_ake ws
  (e_nclose line) c_at width u:l_ines k d_rop ws
}

# A text wrapped at its spaces into lines of at most width characters.
u:w_rap := { width t -> width u:l_ines (n_ot t = f_irst " ") p_artition t }

# A result's lines as one, " / " between them (a matrix, or a language's
# own box drawing of one, on a face's single result line).
u:o_neLine := { out -> d_isclose '{ x y -> e_nclose (d_isclose x) c_at " / " c_at d_isclose y } r_/ (n_ot out = f_irst "\n") p_artition out }

# The lines of a language's face for an idiom: its name, the source
# colored (on two lines when it is long, each shrunk to fit), and the
# output when there is one; or the note for a missing source, wrapped.
# Each line is markup.
u:f_ace := { i l ->
  name := v:e_scape d_isclose l s_elect languageNames
  src := d_isclose l s_elect i s_elect source
  out := d_isclose l s_elect i s_elect output
  note := d_isclose l s_elect i s_elect notes
  missing := "0 = t_ally note" i_f< "\"(no concise idiom)\"; note"
  result := "0 = t_ally out" i_f< "\"\"; \"-> \" c_at u:o_neLine out"
  n_oteLine := { b -> 0.07 v:s_ized "#4b5563" v:s_pan d_isclose b }
  0 = t_ally src ? (e_nclose name) c_at 'n_oteLine m_ap 18 u:w_rap missing
  c_odeLine := { b -> (t_ally d_isclose b) u:f_itted (i c_at l) u:c_olored d_isclose b }
  code := 'c_odeLine m_ap u:s_plit src
  (e_nclose name) c_at code c_at e_nclose (t_ally result) u:f_itted "#4b5563" v:s_pan result
}

# The item an axis's side shows: the one its turn started from plus
# the side's offset, wrapped. `(axis offset) u:i_tem state`.
u:i_tem := { ao state ->
  axis := 1 s_elect ao
  n := f_loor 0.5 + (axis c_at cm:COUNT) cm:a_t state
  n cm:w_rap 1 + (f_loor 2 s_elect ao) + st:b_ase (axis c_at cm:ANGLE) cm:a_t state
}

# The stone as a picture of a state: the two halves' sides show the
# languages for the idiom the stone stands on, the top half's lid and
# the bottom half's floor name the neighboring idioms, the caps between
# the halves are bare; everything is painted far to near as one solid.
# Faces 1 to 6 are the top half's (front, right, back, left, lid,
# floor), 7 to 12 the bottom half's.
u:s_tone := { state ->
  i := (cm:IDIOM c_at 0.0) u:i_tem state
  roll := (cm:IDIOM c_at cm:ANGLE) cm:a_t state
  top := 1 st:r_ing ((cm:TOP c_at cm:ANGLE) cm:a_t state) c_at roll
  bottom := -1 st:r_ing ((cm:BOTTOM c_at cm:ANGLE) cm:a_t state) c_at roll
  all := top c_at bottom
  c_apName := { k -> v:e_scape d_isclose ((cm:IDIOM c_at f_loat k s_elect st:capOffsets) u:i_tem state) s_elect idiomNames }
  c_apText := { k ->
    k = 5 ? c_apName 1
    k = 12 ? c_apName 2
    ""
  }
  c_ap := { k -> (e_nclose "#e9e4db") c_at (e_nclose "") c_at e_nclose c_apText k }
  t_opPanel := { k -> (e_nclose "#fdfcfa") c_at i u:f_ace (cm:TOP c_at f_loat k s_elect st:ringOffsets) u:i_tem state }
  b_ottomPanel := { k -> (e_nclose "#f4f1ec") c_at i u:f_ace (cm:BOTTOM c_at f_loat k s_elect st:ringOffsets) u:i_tem state }
  l_ines := { k ->
    k <= 4 ? t_opPanel k
    k <= 6 ? c_ap k
    k <= 10 ? b_ottomPanel k - 6
    c_ap k
  }
  p_anel := { k -> (l_ines k) st:p_anel k s_elect all }
  painted := u:j_oin 'p_anel m_ap st:p_ainting all
  caption := ((v:a_t (st:size / 2) c_at 28) c_at ("font-size" v:a_ttr "18") c_at ("text-anchor" v:a_ttr "middle") c_at (v:f_ill "#374151") c_at "font-family" v:a_ttr "ui-sans-serif, system-ui, sans-serif") v:t_ext d_isclose i s_elect idiomNames
  (st:size c_at st:size) v:p_icture caption c_at painted
}

u:j_oin := { b -> d_isclose '{ x y -> e_nclose (d_isclose x) c_at d_isclose y } r_/ b }

# Where the stone stands, for the host: "at IDIOM TOP BOTTOM" by their
# keys, printed whenever it changes (the page reads it for its controls
# and the address bar). It names what the faces show, which changes
# when a turn lands, not what an axis is turning toward (its steps),
# so the page's lists never run ahead of the picture.
u:w_here := { s ->
  i := d_isclose ((cm:IDIOM c_at 0.0) u:i_tem s) s_elect idioms
  t := d_isclose ((cm:TOP c_at 0.0) u:i_tem s) s_elect languages
  b := d_isclose ((cm:BOTTOM c_at 0.0) u:i_tem s) s_elect languages
  "at " c_at i c_at " " c_at t c_at " " c_at b
}

# The loop: an event, the state after it, a frame on each tick, the
# position when it changes; the state when the events end.
u:l_oop := { state ->
  e := []E_VENT @
  kind := []E_KIND e
  kind m_atch "end" ? state
  next := state cm:u_pdate e
  "(u:w_here state) m_atch u:w_here next" u_nless< "p_rint! u:w_here next"
  "n_ot kind m_atch \"tick\"" u_nless< "[]S_HOW u:s_tone next"
  u:l_oop next
}

# Start at the beginning of the tour: the first idiom, the first
# language on top and the second below, at rest, every axis playing
# (the attract mode begins after the first dwell).
start := cm:r_esume cm:s_ettle (cm:BOTTOM c_at 2.0) cm:c_hoose (t_ally idioms) cm:s_tart t_ally languages
shown := p_rint! u:w_here start
u:l_oop start
