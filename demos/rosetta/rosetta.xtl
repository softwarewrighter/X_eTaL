#!/usr/bin/env xetal
# The Rosetta stone (docs/rosetta.md): how languages write the same
# idiom, on an impossible object. The whole stone rolls through the
# idioms; its top half turns through the languages; its bottom half
# turns, on its own, through the languages compared with. The data is
# demos/rosetta/data.toml, read as aligned arrays over the two axes.
# This stage draws still pictures: the stone at rest on Rotate, X_eTaL
# over K, then with the top half turning and the drum rolling.
"st:" u_se< "Stone"
"v:" u_se< "Svg"

data := "demos/rosetta/data.toml"
idioms := data []L_IST "idioms"
idiomNames := data []L_IST "idiom_names"
languages := data []L_IST "languages"
languageNames := data []L_IST "language_names"
u:t_able := { name -> ((e_nclose data) c_at e_nclose name) []T_ABLE "idioms" "languages" }
source := u:t_able "source"
output := u:t_able "output"
notes := u:t_able "notes"

# An index into an axis, wrapped around: item k of n, for any integer k.
u:w_rap := { n k -> 1 + (k - 1) m_od n }

# The text lines of a language's face for an idiom: its name, the
# source, and the output when there is one, or the note for a missing
# source.
u:f_ace := { i l ->
  name := d_isclose l s_elect languageNames
  src := d_isclose l s_elect i s_elect source
  out := d_isclose l s_elect i s_elect output
  note := d_isclose l s_elect i s_elect notes
  missing := "0 = t_ally note" i_f< "\"(no concise idiom)\"; note"
  result := "0 = t_ally out" i_f< "\"\"; \"-> \" c_at out"
  0 = t_ally src ? (e_nclose name) c_at e_nclose missing
  (e_nclose name) c_at (e_nclose src) c_at e_nclose result
}

# The stone as a picture: idiom i facing, language t on top and b
# below, the drum rolled by ia degrees and the rings turned by ta and
# ba. The drum's top, bottom and back sides name the neighboring
# idioms; the rings' sides show the languages, the neighbors on their
# sides; everything is painted far to near as one solid.
u:s_tone := { itb angles ->
  i := 1 s_elect itb
  t := 2 s_elect itb
  b := 3 s_elect itb
  drum := st:d_rum 1 s_elect angles
  top := 1 st:r_ing 2 s_elect angles
  bottom := -1 st:r_ing 3 s_elect angles
  n := t_ally idioms
  m := t_ally languages
  d_rumPanel := { k -> ((e_nclose "#d9d2c5") c_at (n u:w_rap i + k s_elect st:drumOffsets) s_elect idiomNames) st:p_anel k s_elect drum }
  t_opPanel := { k -> ((e_nclose "#f2ede4") c_at i u:f_ace m u:w_rap t + k s_elect st:ringOffsets) st:p_anel k s_elect top }
  b_ottomPanel := { k -> ((e_nclose "#e6e0d4") c_at i u:f_ace m u:w_rap b + k s_elect st:ringOffsets) st:p_anel k s_elect bottom }
  p_anel := { k -> k <= 3 ? d_rumPanel k; k <= 7 ? t_opPanel k - 3; b_ottomPanel k - 7 }
  all := drum c_at top c_at bottom
  painted := u:j_oin 'p_anel m_ap st:p_ainting all
  (st:size c_at st:size) v:p_icture painted
}

u:j_oin := { b -> d_isclose '{ x y -> e_nclose (d_isclose x) c_at d_isclose y } r_/ b }

rotate := idioms i_ndexOf e_nclose "rotate"
xetal := languages i_ndexOf e_nclose "xetal"
k := languages i_ndexOf e_nclose "k"
at := rotate c_at xetal c_at k
shown := []S_HOW at u:s_tone 0.0 0.0 0.0
shown := []S_HOW at u:s_tone 0.0 35.0 0.0
shown := []S_HOW at u:s_tone 25.0 0.0 -50.0
"the stone, three ways"
