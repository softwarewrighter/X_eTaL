#!/usr/bin/env xetal
## TTTML, part 2: play the machine that demos/tttml-train.xtl trained
## (run that first), with "xetal run demos/tttml-play.xtl". You are X and
## move first: type a square, 1 to 9, numbered row by row. Something
## that is not an empty square is asked for again. Uses the TTTML
## library (lib/TTTML.xtl).

"t:" u_se< "TTTML"

### The model

# The model, read back: []N_GET reads the file's text, n_umbers the
# numbers in it, and r_eshape makes the two rows again.

## The numbers of work/tttml.model: the codes, then the values.
v := n_umbers []N_GET "work/tttml.model"
## The model: two rows, the codes of the positions met and their
## values.
m := (2 c_at (t_ally v) d_iv 2) r_eshape v
t_ally 1 s_elect m

### The game

## u:a_sk s: your move on board s, read from the keyboard: the square
## typed, 1 to 9; anything but an empty square asks again.
u:a_sk := { s ->
  shown := p_rint! "your move (1 to 9):"
  t := []R_EAD @
  k := "123456789" i_ndexOf f_irst t c_at " "
  (k <= 9) & 0 = k s_elect s c_at 1 ? k; u:a_sk s
}

## u:y_ou s: you move on board s, then it replies, until the game is
## over; the final board. Each board is printed as it is played.
u:y_ou := { s ->
  played := s t:a_fter u:a_sk s
  _ := p_rint! t:s_how played
  _ := p_rint! ""
  0 = t:o_utcome played ? u:m_e played; played
}
## u:m_e s: the machine moves on board s (its best move from model
## m), then you, until the game is over; the final board.
u:m_e := { s ->
  played := s t:a_fter m t:c_hoose s
  _ := p_rint! t:s_how played
  _ := p_rint! ""
  0 = t:o_utcome played ? u:y_ou played; played
}
## u:v_erdict w: an outcome said from your side: 1 "you win", -1 "it
## wins", anything else "a draw".
u:v_erdict := { w -> w = 1 ? "you win"; w = -1 ? "it wins"; "a draw" }

u:v_erdict t:o_utcome u:y_ou 9 r_eshape 0
