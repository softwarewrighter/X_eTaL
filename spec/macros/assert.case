# "cond" a_ssert< "message" stops the program when the condition does
# not hold, as Rust's assert! does (MC34); when it holds its value is @.
== SOURCE
x := 6
"x > 1" a_ssert< "x is more than one"
"x < 10" a_ssert< @
x
== EXPAND
x := 6
{ @ ->
  (x > 1) ? @
  "assertion" []S_IGNAL "assertion failed: x > 1 (x is more than one)"
} @
{ @ -> (x < 10) ? @; "assertion" []S_IGNAL "assertion failed: x < 10" } @
x
== RESULT
@
@
6
