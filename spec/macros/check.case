# "cond" c_heck< "message" reports a failed condition, as written, on
# standard error and goes on; its value is @ (MC34: c_heck< stops).
== SOURCE
x := 6
"x > 10" c_heck< "x is big"
"x > 1" c_heck< @
x
== EXPAND
x := 6
{ @ -> (x > 10) ? @; []E_RR "check failed: x > 10 (x is big) [-e:2]"; @ } @
{ @ -> (x > 1) ? @; []E_RR "check failed: x > 1 [-e:3]"; @ } @
x
== RESULT
@
@
6
