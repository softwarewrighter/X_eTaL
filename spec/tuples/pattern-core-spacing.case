# Rule 8: the same pattern written with other spacing and on two
# lines gives the same Core as pattern-core.
== SOURCE
s := (1, (2, 3), 4)
( a,( b,_ ),
  c ) := s
== CORE
(let s (tuple 1 (tuple 2 3) 4))
(let %1 s)
(let a (part 0 3 %1))
(let %2 (part 1 3 %1))
(let b (part 0 2 %2))
(let c (part 2 3 %1))
