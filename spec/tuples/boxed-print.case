# TU8: a boxed tuple is drawn in its box, marked nested; a vector of
# them is the array of tuples, and array functions act on the boxes.
== SOURCE
ps := '{ k -> (k, f_loat k) } m_ap r_ange 3
t_ally ps
r_ev ps
e_nclose (1, 2.5)
== RESULT
3
┌→─────────────────────────────────┐
│ ┌────────┐ ┌────────┐ ┌────────┐ │
│ │(3, 3.0)│ │(2, 2.0)│ │(1, 1.0)│ │
│ └∊───────┘ └∊───────┘ └∊───────┘ │
└∊─────────────────────────────────┘
┌────────┐
│(1, 2.5)│
└∊───────┘
