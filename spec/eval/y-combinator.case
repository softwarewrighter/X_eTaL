# Y needs a self-applied argument, an infinite type: the checker
# refuses it (T6); `xetal run --untyped` runs it (see the golden).
== SOURCE
u:Y_ := { f_ -> { x_ -> f_ x_ 'x_ } '{ x_ -> f_ x_ 'x_ } }
u:F_ := { ~s_elf n -> n <= 1 ? 1; n * s_elf n - 1 }
(u:Y_ 'u:F_)_ 5
== ERROR
error[infinite-type]: a type would contain itself: a -> b at 27..33
