r_ev_1 m
1 o_-_2 m
'+ r_/_2 m
'+ s_\_2 m
2 t_ake_2 m
u:f_lip := { r_ev _r }
u:f_lip_2 m
u:s_um := { '+ r_/ _r }
u:s_um_2 m
u:p_air := { a b -> a c_at b }
9 u:p_air_2 m
r_ev_1 5
