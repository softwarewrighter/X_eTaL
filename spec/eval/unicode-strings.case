# drawn, spaces removed.
== SOURCE
g := "hello X̲ᵉTᵃL"   # a comment may too: ⍝ café
g c_at "!"
t_ally "é"
== RENDER
g ← "hello X̲ᵉTᵃL"   ⍝ a comment may too: ⍝ café
g c̲at "!"
t̲ally "é"
