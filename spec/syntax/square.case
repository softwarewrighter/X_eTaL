# The M1 square demo.
== SOURCE
u:s_quare := { _r * _r }; u:s_quare 7
== SURFACE
(:= u:s_quare (lambda (_r) (* _r _r)))
(u:s_quare 7)
== CANONICAL
u:s_quare := { (_r * _r) }
(u:s_quare 7)
== CORE
(def u:s_quare (lam _r (app2 #* _r _r)))
(eval (app u:s_quare 7))
== TYPE
u:s_quare : Num a => a -> a
Int
