# The M1 subtraction demo.
== SOURCE
u:s_ub := { _l - _r }; 10 u:s_ub 3
== SURFACE
(:= u:s_ub (lambda (_l _r) (- _l _r)))
(u:s_ub 10 3)
== CANONICAL
u:s_ub := { (_l - _r) }
(10 u:s_ub 3)
== CORE
(def u:s_ub (lam _l (lam _r (app2 #- _l _r))))
(eval (app2 u:s_ub 10 3))
== TYPE
u:s_ub : Num a => a -> a -> a
Int
