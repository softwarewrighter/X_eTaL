# Newlines separate statements inside braces (S2, G1).
== SOURCE
u:f_act := { n ->
  n <= 1 ? 1
  n * u:f_act n - 1
}
== SURFACE
(:= u:f_act (lambda (n) (? (<= n 1) 1) (* n (u:f_act (- n 1)))))
== CANONICAL
u:f_act := { n -> (n <= 1) ? 1; (n * (u:f_act (n - 1))) }
== CORE
(def u:f_act (lam n (if (app2 #<= n 1) 1 (app2 #* n (app u:f_act (app2 #- n 1))))))
== TYPE
u:f_act : Num a => a -> a
