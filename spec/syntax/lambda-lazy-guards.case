# A lazy parameter and a guard (E1, G1).
== SOURCE
{ ~s_elf n -> n <= 1 ? 1; n * s_elf n - 1 }
== SURFACE
(lambda (~s_elf n) (? (<= n 1) 1) (* n (s_elf (- n 1))))
== CANONICAL
{ ~s_elf n -> (n <= 1) ? 1; (n * (s_elf (n - 1))) }
== CORE
(eval (lam ~s_elf (lam n (if (app2 #<= n 1) 1 (app2 #* n (app s_elf (app2 #- n 1)))))))
