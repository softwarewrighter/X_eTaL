## Greetings: a library with a private name. h:n_ame is file-private, so it is
## used here but cannot be imported; g_reet is exported, and takes the
## greeting from the program that calls it. Import it with an alias of
## your choice: "g:" u_se< "Greetings" (it is found in userlibs/).

## The name a greeting is addressed to, the logo drawn (niladic: call
## it with @).
h:n_ame := { @ -> "X̲ᵉTᵃL" }                  # private

## The greeting g, given by the caller, followed by the name: monadic,
## `g:g_reet "hi"`.
## >> "g:" u_se< "Greetings"
## >> g:g_reet "hi"
## hi X̲ᵉTᵃL
l:g_reet := { g -> g c_at " " c_at h:n_ame @ } # monadic: the greeting
