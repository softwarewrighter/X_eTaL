#!/usr/bin/env xetal
## Nim: heaps of counters; take any number from one heap; whoever takes
## the last counter wins. The winning move makes the xor of the heaps
## (the nim-sum) zero, worked out for every heap at once.
## Run with "just demo Bits nim".

"b:" u_se< "Bits"
heaps := 3 4 5
nimsum := (f_irst heaps) b:x_or (f_irst 1 d_rop heaps) b:x_or f_irst 2 d_rop heaps
nimsum                                  # not 0: the player to move can win

# Each heap brought to heap xor nim-sum; a move where that is smaller.
target := heaps b:x_or nimsum
target
(target < heaps) r_eplicate r_ange 3    # the heaps a winning move can use

# The move: heap 1 from 3 down to 1. In binary, a row per heap, every
# column then holds an even number of ones: the nim-sum is 0.
after := heaps - 2 * (r_ange 3) = 1
3 b:b_its after
(f_irst after) b:x_or (f_irst 1 d_rop after) b:x_or f_irst 2 d_rop after
