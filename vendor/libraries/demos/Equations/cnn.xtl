#!/usr/bin/env xetal
## One CNN layer as the paper writes it: Y[o,h,w] is the sum over c,
## r and s of X[c,h+r,w+s] * W[o,c,r,s], two 4 by 4 pictures
## (channels) through one 2 by 2 by 2 filter. One call gives the
## result and its LaTeX (a line between $$ is drawn as math in the
## live demo); the result is checked against the library's
## cross-correlation. Run with "just demo Equations cnn".
"e:" u_se< "Equations"

X := 2 4 4 r_eshape r_ange 32
W := 1 2 2 2 r_eshape r_ange 8
(C, Kh, Kw) := (2, 2, 2)
(O, Ho, Wo) := (1, 3, 3)
(Y, tex) := "Y[o,h,w] | O Ho Wo" e:b_oth< "sum c:=0..C - 1, sum r:=0..Kh - 1, sum s:=0..Kw - 1 | X[c,h+r,w+s] * W[o,c,r,s]"
"$$" c_at tex c_at "$$"
Y
Y m_atch X e:c_orrelate W
